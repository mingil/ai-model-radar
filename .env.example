# ============================================================================
# 📡 AI Model Radar (.env.example)
# 💡 별도의 API 키를 하나도 입력하지 않아도 OpenRouter + LiteLLM 공개 허브를 통해
#    전 세계 450+ 최신 AI 모델 조회, 가격/스펙 비교, 글로벌 가동률 확인이 100% 작동합니다!
# ============================================================================

# --- 🌐 1. 통합 AI 허브 API 키 (선택 사항 — 1개만 있어도 전 세계 모델 1토큰 실호출 Ping 가능) ---
OPENROUTER_API_KEY=

# --- 🔑 2. 주요 제조사 개별 공식 API 키 (선택 사항 — 보유한 키만 입력) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# --- ✈️ 3. 텔레그램 봇 조회 & 신규/단종 모델 푸시 알림 (선택 사항) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ⚙️ 4. 웹 대시보드 보안 비밀번호 및 스케줄러 설정 ---
# 웹 대시보드 접속 비밀번호 (쉼표로 복수 비밀번호 지정 가능)
DASHBOARD_PASSWORD=admin1234
SCAN_INTERVAL_HOURS=6
ALERT_ON_NEW_MODEL=true
ALERT_ON_DEPRECATED=true
PORT=8500
